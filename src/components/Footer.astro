---
/**
 * Footer — site navigation, branding, and theme toggle
 * Minimal design matching brand aesthetic
 */
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const currentYear = new Date().getFullYear();

const links = [
  { label: 'App', href: 'https://count.racku.la' },
  { label: 'GitHub', href: 'https://github.com/RackulaLives/Rackula' },
  { label: 'Docs', href: 'https://docs.racku.la' },
];
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__top">
      <!-- Logo and branding -->
      <div class="footer__brand">
        <a href="/" class="footer__logo-link" aria-label="Rackula home">
          <Logo variant="solid" size="sm" />
          <span class="footer__wordmark">Rackula</span>
        </a>
      </div>

      <!-- Navigation links -->
      <nav class="footer__nav" aria-label="Footer navigation">
        <ul class="footer__links">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="footer__link"
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Theme toggle -->
      <div class="footer__actions">
        <ThemeToggle />
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">
        Built with <span class="footer__vampire" aria-label="vampire">🧛</span> by the Rackula project
      </p>
      <p class="footer__copyright">
        © {currentYear} RackulaLives. MIT License.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-8) var(--space-4);
    background-color: var(--colour-bg-darkest);
    border-top: 1px solid var(--colour-border);
  }

  .footer__container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .footer__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--colour-border);
  }

  /* Brand */
  .footer__brand {
    display: flex;
    align-items: center;
  }

  .footer__logo-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--colour-text-primary);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .footer__logo-link:hover {
    color: var(--colour-purple);
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
  }

  /* Navigation */
  .footer__nav {
    width: 100%;
  }

  .footer__links {
    display: flex;
    justify-content: center;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--colour-text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .footer__link:hover {
    color: var(--colour-cyan);
  }

  /* Actions */
  .footer__actions {
    display: flex;
    align-items: center;
  }

  /* Bottom section */
  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-6);
    text-align: center;
  }

  .footer__copy {
    font-size: var(--text-sm);
    color: var(--colour-text-secondary);
    margin: 0;
  }

  .footer__vampire {
    font-style: normal;
  }

  .footer__copyright {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--colour-text-secondary);
    opacity: 0.7;
    margin: 0;
  }

  /* Desktop layout */
  @media (min-width: 768px) {
    .footer {
      padding: var(--space-8);
    }

    .footer__top {
      flex-direction: row;
      justify-content: space-between;
    }

    .footer__nav {
      width: auto;
    }

    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
