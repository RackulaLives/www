---
/**
 * OpenSource — FOSS callout highlighting community and transparency
 * Complements SelfHost section which covers Docker deployment
 */
import SectionHeader from './SectionHeader.astro';
import Button from './Button.astro';
---

<section class="open-source" id="open-source">
  <div class="open-source__container">
    <SectionHeader>open source</SectionHeader>

    <div class="open-source__content">
      <div class="open-source__text">
        <p class="open-source__intro">
          Rackula is free and open source software. No tracking, no vendor lock-in, no surprises.
        </p>

        <div class="open-source__badges">
          <a
            href="https://github.com/RackulaLives/Rackula/blob/main/LICENSE"
            class="badge"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="badge__label">License</span>
            <span class="badge__value">MIT</span>
          </a>
          <a
            href="https://github.com/RackulaLives/Rackula"
            class="badge"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="badge__label">Tests</span>
            <span class="badge__value">1400+</span>
          </a>
          <a
            href="https://github.com/RackulaLives/Rackula/stargazers"
            class="badge badge--star"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="badge__star-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span class="badge__value">Star on GitHub</span>
          </a>
        </div>

        <ul class="open-source__features">
          <li>
            <svg class="open-source__check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Fork it, modify it, make it yours</span>
          </li>
          <li>
            <svg class="open-source__check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Community-driven development</span>
          </li>
          <li>
            <svg class="open-source__check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Transparent roadmap and issues</span>
          </li>
        </ul>

        <div class="open-source__cta">
          <Button href="https://github.com/RackulaLives/Rackula" variant="secondary" size="md">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .open-source {
    padding: var(--space-16) var(--space-4);
    background-color: var(--colour-bg-darker);
  }

  .open-source__container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .open-source__content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .open-source__text {
    max-width: 40rem;
    text-align: center;
  }

  .open-source__intro {
    font-size: var(--text-lg);
    color: var(--colour-text-primary);
    margin-bottom: var(--space-6);
  }

  /* Badges */
  .open-source__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    background-color: var(--colour-bg-primary);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-default),
                transform var(--duration-fast) var(--ease-default);
  }

  .badge:hover {
    border-color: var(--colour-purple);
    transform: translateY(-1px);
  }

  .badge__label {
    color: var(--colour-text-secondary);
  }

  .badge__value {
    color: var(--colour-cyan);
    font-weight: var(--font-medium);
  }

  .badge--star {
    background-color: var(--colour-bg-light);
  }

  .badge--star .badge__value {
    color: var(--colour-yellow);
  }

  .badge__star-icon {
    color: var(--colour-yellow);
  }

  /* Features list */
  .open-source__features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .open-source__features li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--colour-text-secondary);
    font-size: var(--text-base);
  }

  .open-source__check {
    color: var(--colour-green);
    flex-shrink: 0;
  }

  .open-source__cta {
    margin-top: var(--space-4);
  }

  /* Desktop */
  @media (min-width: 768px) {
    .open-source {
      padding: var(--space-16) var(--space-8);
    }

    .open-source__intro {
      font-size: var(--text-xl);
    }
  }
</style>
