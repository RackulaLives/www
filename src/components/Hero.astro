---
/**
 * Hero — landing section with logo and CTAs
 * Uses the coffin-taper mark with hover-triggered animation
 */
import Button from './Button.astro';
---

<section class="hero">
  <div class="hero__content">
    <!-- Logo mark (coffin taper) — solid purple, animates on hover.
         Decorative: aria-hidden keeps it out of the a11y tree, so tabindex
         is removed to avoid the aria-hidden + focusable contradiction. -->
    <div class="hero__logo" aria-hidden="true">
      <svg
        class="hero__logo-svg"
        width="76"
        height="108"
        viewBox="0 0 56 80"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Rackula logo"
      >
        <!-- Coffin outline with fang notch — solid brand purple -->
        <path
          d="M1.5 0Q0 0 0 1.5L0 16.5L2.6 77.5Q2.6 80 5.1 80L50.9 80Q53.4 80 53.4 77.5L56 16.5L56 1.5Q56 0 54.5 0L39.5 0Q38.2 0 37 2.6L28 17.8L19 2.6Q17.8 0 16.5 0Z"
          fill="var(--colour-purple)"
          class="hero__logo-frame"
        />

        <!-- Tapered device bays with heartbeat staggered animation -->
        <rect x="5.6" y="21.5" width="44.8" height="13" rx="2" class="hero__logo-slot hero__logo-slot--1" />
        <rect x="7.4" y="40.5" width="41.2" height="13" rx="2" class="hero__logo-slot hero__logo-slot--2" />
        <rect x="9.2" y="59.5" width="37.6" height="13" rx="2" class="hero__logo-slot hero__logo-slot--3" />
      </svg>
    </div>

    <!-- Visually hidden brand name for SEO/accessibility -->
    <h1 class="sr-only">Rackula</h1>

    <!-- Tagline as primary visible heading -->
    <p class="hero__tagline" role="doc-subtitle">
      Plan your homelab rack layout.
    </p>

    <!-- Subtext -->
    <p class="hero__subtext">
      Drag-and-drop planning. Export anywhere. Self-host forever.
    </p>

    <!-- CTAs -->
    <div class="hero__ctas">
      <Button href="https://count.racku.la" variant="primary" size="lg">
        Start Planning
      </Button>
      <Button href="https://github.com/RackulaLives/Rackula" variant="secondary" size="lg">
        View on GitHub
      </Button>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: var(--space-8) var(--space-4);
    background-color: var(--colour-bg-primary);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 48rem;
    gap: var(--space-6);
  }

  /* Logo — static by default, animates on hover (decorative: not focusable) */
  .hero__logo {
    margin-bottom: var(--space-4);
    cursor: pointer;
    border-radius: var(--radius-md);
    outline: none;
  }

  .hero__logo-svg {
    filter: drop-shadow(0 0 8px var(--colour-glow-purple));
    transition: filter var(--duration-normal) var(--ease-default);
  }

  /* Slots are background colour by default — colours reveal on hover */
  .hero__logo-slot--1,
  .hero__logo-slot--2,
  .hero__logo-slot--3 {
    fill: var(--colour-bg-primary);
    transition: fill var(--duration-normal) var(--ease-default);
  }

  /* Hover state — trigger animation */
  .hero__logo:hover .hero__logo-svg {
    filter: drop-shadow(0 0 20px var(--colour-glow-purple));
  }

  .hero__logo:hover .hero__logo-frame {
    animation: frame-glow 2s ease-in-out infinite;
  }

  .hero__logo:hover .hero__logo-slot {
    animation: slot-pulse 2s ease-in-out infinite;
  }

  .hero__logo:hover .hero__logo-slot--1 {
    animation-name: slot-pulse-cyan;
    animation-delay: 0s;
  }

  .hero__logo:hover .hero__logo-slot--2 {
    animation-name: slot-pulse-green;
    animation-delay: 0.15s;
  }

  .hero__logo:hover .hero__logo-slot--3 {
    animation-name: slot-pulse-pink;
    animation-delay: 0.3s;
  }

  @keyframes frame-glow {
    0%, 100% {
      filter: drop-shadow(0 0 4px var(--colour-glow-purple));
    }
    50% {
      filter: drop-shadow(0 0 16px var(--colour-glow-purple));
    }
  }

  @keyframes slot-pulse-cyan {
    0%, 100% {
      fill: var(--colour-cyan);
    }
    50% {
      fill: var(--colour-bg-primary);
    }
  }

  @keyframes slot-pulse-green {
    0%, 100% {
      fill: var(--colour-green);
    }
    50% {
      fill: var(--colour-bg-primary);
    }
  }

  @keyframes slot-pulse-pink {
    0%, 100% {
      fill: var(--colour-pink);
    }
    50% {
      fill: var(--colour-bg-primary);
    }
  }

  /* Respect reduced motion preference — no animation even on hover */
  @media (prefers-reduced-motion: reduce) {
    .hero__logo:hover .hero__logo-frame,
    .hero__logo:hover .hero__logo-slot {
      animation: none;
    }
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Typography */
  .hero__tagline {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    color: var(--colour-text-primary);
    line-height: 1.2;
    margin: 0;
  }

  .hero__subtext {
    font-size: var(--text-lg);
    color: var(--colour-text-muted);
    max-width: 32rem;
    margin: 0;
  }

  /* CTAs */
  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: 20rem;
    margin-top: var(--space-4);
  }

  /* Desktop styles */
  @media (min-width: 640px) {
    .hero__tagline {
      font-size: var(--text-4xl);
    }

    .hero__ctas {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }

    .hero__logo-svg {
      width: 101px;
      height: 144px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding: var(--space-16) var(--space-8);
    }

    .hero__logo-svg {
      width: 113px;
      height: 162px;
    }
  }
</style>
