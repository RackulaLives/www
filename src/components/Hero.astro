---
/**
 * Hero — landing section with logo and CTAs
 * Uses v2 widow's peak mark with hover-triggered animation
 */
import Button from './Button.astro';
---

<section class="hero">
  <div class="hero__content">
    <!-- Gradient logo (v2 widow's peak) — animates on hover -->
    <div class="hero__logo" aria-hidden="true" tabindex="0">
      <svg
        class="hero__logo-svg"
        width="72"
        height="108"
        viewBox="0 0 36 54"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label="Rackula logo"
      >
        <defs>
          <linearGradient id="hero-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="var(--colour-purple)" />
            <stop offset="50%" stop-color="var(--colour-pink)" />
            <stop offset="100%" stop-color="var(--colour-cyan)" />
          </linearGradient>
        </defs>

        <!-- Outer frame with widow's peak (v2) -->
        <path
          d="M0 0 L14 0 L18 6 L22 0 L36 0 L36 54 L0 54 Z"
          fill="url(#hero-gradient)"
          class="hero__logo-frame"
        />

        <!-- Slots with heartbeat staggered animation -->
        <rect x="5" y="10" width="26" height="10" class="hero__logo-slot hero__logo-slot--1" />
        <rect x="5" y="22" width="26" height="10" class="hero__logo-slot hero__logo-slot--2" />
        <rect x="5" y="34" width="26" height="10" class="hero__logo-slot hero__logo-slot--3" />
      </svg>
    </div>

    <!-- Visually hidden brand name for SEO/accessibility -->
    <h1 class="sr-only">Rackula</h1>

    <!-- Tagline as primary visible heading -->
    <p class="hero__tagline" role="doc-subtitle">
      Plan your homelab rack layout.
    </p>

    <!-- Subtext -->
    <p class="hero__subtext">
      Drag-and-drop planning. Export anywhere. Self-host forever.
    </p>

    <!-- CTAs -->
    <div class="hero__ctas">
      <Button href="https://count.racku.la" variant="primary" size="lg">
        Start Planning
      </Button>
      <Button href="https://github.com/RackulaLives/Rackula" variant="secondary" size="lg">
        View on GitHub
      </Button>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: var(--space-8) var(--space-4);
    background-color: var(--colour-bg-primary);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 48rem;
    gap: var(--space-6);
  }

  /* Logo — static by default, animates on hover/focus */
  .hero__logo {
    margin-bottom: var(--space-4);
    cursor: pointer;
    border-radius: var(--radius-md);
    outline: none;
  }

  .hero__logo:focus-visible {
    box-shadow: var(--focus-ring);
  }

  .hero__logo-svg {
    filter: drop-shadow(0 0 8px var(--colour-glow-purple));
    transition: filter var(--duration-normal) var(--ease-default);
  }

  /* Static slot colours by default */
  .hero__logo-slot--1 {
    fill: var(--colour-cyan);
    transition: fill var(--duration-normal) var(--ease-default);
  }

  .hero__logo-slot--2 {
    fill: var(--colour-green);
    transition: fill var(--duration-normal) var(--ease-default);
  }

  .hero__logo-slot--3 {
    fill: var(--colour-pink);
    transition: fill var(--duration-normal) var(--ease-default);
  }

  /* Hover/focus state — trigger animation */
  .hero__logo:hover .hero__logo-svg,
  .hero__logo:focus .hero__logo-svg {
    filter: drop-shadow(0 0 20px var(--colour-glow-purple));
  }

  .hero__logo:hover .hero__logo-frame,
  .hero__logo:focus .hero__logo-frame {
    animation: frame-glow 2s ease-in-out infinite;
  }

  .hero__logo:hover .hero__logo-slot,
  .hero__logo:focus .hero__logo-slot {
    animation: slot-pulse 2s ease-in-out infinite;
  }

  .hero__logo:hover .hero__logo-slot--1,
  .hero__logo:focus .hero__logo-slot--1 {
    animation-name: slot-pulse-cyan;
    animation-delay: 0s;
  }

  .hero__logo:hover .hero__logo-slot--2,
  .hero__logo:focus .hero__logo-slot--2 {
    animation-name: slot-pulse-green;
    animation-delay: 0.15s;
  }

  .hero__logo:hover .hero__logo-slot--3,
  .hero__logo:focus .hero__logo-slot--3 {
    animation-name: slot-pulse-pink;
    animation-delay: 0.3s;
  }

  @keyframes frame-glow {
    0%, 100% {
      filter: drop-shadow(0 0 4px var(--colour-glow-purple));
    }
    50% {
      filter: drop-shadow(0 0 16px var(--colour-glow-purple));
    }
  }

  @keyframes slot-pulse-cyan {
    0%, 100% {
      fill: var(--colour-cyan);
    }
    50% {
      fill: var(--colour-bg-primary);
    }
  }

  @keyframes slot-pulse-green {
    0%, 100% {
      fill: var(--colour-green);
    }
    50% {
      fill: var(--colour-bg-primary);
    }
  }

  @keyframes slot-pulse-pink {
    0%, 100% {
      fill: var(--colour-pink);
    }
    50% {
      fill: var(--colour-bg-primary);
    }
  }

  /* Respect reduced motion preference — no animation even on hover */
  @media (prefers-reduced-motion: reduce) {
    .hero__logo:hover .hero__logo-frame,
    .hero__logo:focus .hero__logo-frame,
    .hero__logo:hover .hero__logo-slot,
    .hero__logo:focus .hero__logo-slot {
      animation: none;
    }
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Typography */
  .hero__tagline {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    color: var(--colour-text-primary);
    line-height: 1.2;
    margin: 0;
  }

  .hero__subtext {
    font-size: var(--text-lg);
    color: var(--colour-text-secondary);
    max-width: 32rem;
    margin: 0;
  }

  /* CTAs */
  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: 20rem;
    margin-top: var(--space-4);
  }

  /* Desktop styles */
  @media (min-width: 640px) {
    .hero__tagline {
      font-size: var(--text-4xl);
    }

    .hero__ctas {
      flex-direction: row;
      justify-content: center;
      max-width: none;
    }

    .hero__logo-svg {
      width: 96px;
      height: 144px;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding: var(--space-16) var(--space-8);
    }

    .hero__logo-svg {
      width: 108px;
      height: 162px;
    }
  }
</style>
