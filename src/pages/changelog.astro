---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReleases, escapeReleaseBody, releaseDate } from '../lib/changelog';

const releases = await getReleases(20);
---

<BaseLayout
  title="Changelog | Rackula"
  description="Rackula release history, sourced from GitHub Releases."
>
  <article class="changelog">
    <div class="changelog__container">
      <h1 class="changelog__title">Changelog</h1>
      <p class="changelog__intro">
        Active development, in the open. Sourced from
        <a href="https://github.com/RackulaLives/Rackula/releases">GitHub Releases</a>.
      </p>
      <ul class="changelog__list">
        {releases.map((release) => (
          <li class="changelog__entry">
            <header class="changelog__entry-head">
              <a class="changelog__tag" href={release.html_url}>
                {release.name || release.tag_name}
              </a>
              <time class="changelog__date" datetime={release.published_at}>
                {releaseDate(release.published_at)}
              </time>
            </header>
            <div class="changelog__body" set:html={escapeReleaseBody(release.body)} />
          </li>
        ))}
      </ul>
    </div>
  </article>
</BaseLayout>

<style>
  .changelog { padding: var(--space-16) var(--space-4); background-color: var(--colour-bg-primary); }
  .changelog__container { max-width: 42rem; margin: 0 auto; }
  .changelog__title { font-family: var(--font-display); font-size: var(--text-4xl); color: var(--colour-text-primary); margin: 0 0 var(--space-2); }
  .changelog__intro { color: var(--colour-text-secondary); margin: 0 0 var(--space-8); }
  .changelog__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-8); }
  .changelog__entry { border-left: 2px solid var(--colour-purple); padding-left: var(--space-6); }
  .changelog__entry-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-3); flex-wrap: wrap; }
  .changelog__tag { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: var(--font-semibold); color: var(--colour-cyan); text-decoration: none; }
  .changelog__tag:hover { color: var(--colour-link-hover); }
  .changelog__date { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--colour-text-secondary); }
  .changelog__body { color: var(--colour-text-primary); line-height: 1.7; }
  .changelog__body :global(p) { margin: 0 0 var(--space-3); }
</style>