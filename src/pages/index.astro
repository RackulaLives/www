---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Rackula — Plan Your Homelab Rack"
  description="Free, open-source rack layout designer for homelabbers. Plan your equipment arrangement before mounting. Self-host with Docker."
>
  <main class="hero">
    <div class="hero-content">
      <div class="logo" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="80" height="80">
          <defs>
            <linearGradient id="dracula-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#BD93F9"/>
              <stop offset="50%" stop-color="#FF79C6"/>
              <stop offset="100%" stop-color="#8BE9FD"/>
            </linearGradient>
          </defs>
          <path fill="url(#dracula-gradient)" fill-rule="evenodd"
            d="M6 4 h20 v24 h-20 z M10 8 h12 v4 h-12 z M10 14 h12 v4 h-12 z M10 20 h12 v4 h-12 z"/>
        </svg>
      </div>

      <h1>Rackula</h1>
      <p class="tagline">Plan your homelab rack layout.</p>

      <div class="cta-group">
        <a href="https://count.racku.la" class="btn btn-primary">
          Open App
        </a>
        <a href="https://github.com/RackulaLives/Rackula" class="btn btn-secondary">
          View Source
        </a>
      </div>

      <p class="note">Free. Open source. Self-hostable.</p>
    </div>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .hero-content {
    text-align: center;
    max-width: 600px;
  }

  .logo {
    margin-bottom: var(--space-6);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    margin-bottom: var(--space-2);
  }

  .tagline {
    font-size: var(--text-xl);
    color: var(--colour-text-secondary);
    margin-bottom: var(--space-8);
  }

  .cta-group {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .btn {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    transition: all var(--duration-normal) var(--ease-default);
    display: inline-block;
  }

  .btn-primary {
    background-color: var(--colour-cyan);
    color: var(--colour-bg-primary);
    box-shadow: var(--glow-sm);
  }

  .btn-primary:hover {
    background-color: var(--colour-green);
    box-shadow: var(--glow-md);
    transform: translateY(-2px);
    color: var(--colour-bg-primary);
  }

  .btn-secondary {
    background-color: var(--colour-bg-light);
    color: var(--colour-text-primary);
    border: var(--border-thin) solid var(--colour-border);
  }

  .btn-secondary:hover {
    border-color: var(--colour-purple);
    box-shadow: 0 0 20px var(--colour-glow-purple);
    color: var(--colour-text-primary);
  }

  .note {
    font-size: var(--text-sm);
    color: var(--colour-text-secondary);
    margin: 0;
  }
</style>
