---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | Rackula"
  description="This rack slot is empty. The page you wanted isn't here."
>
  <section class="not-found">
    <div class="not-found__content">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">This slot is empty</h1>
      <p class="not-found__text">
        The page you tried to mount doesn't exist. Maybe it was relocated to a
        different U.
      </p>
      <div class="not-found__actions">
        <a class="not-found__link" href="/">Back to the homepage</a>
        <a class="not-found__link not-found__link--ghost" href="https://count.racku.la">Open the app →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    padding: var(--space-8) var(--space-4);
    background-color: var(--colour-bg-primary);
  }
  .not-found__content { text-align: center; max-width: 32rem; }
  .not-found__code {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 700;
    color: var(--colour-purple);
    margin: 0 0 var(--space-2);
    line-height: 1;
  }
  .not-found__title {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    color: var(--colour-text-primary);
    margin: 0 0 var(--space-4);
  }
  .not-found__text {
    color: var(--colour-text-secondary);
    margin: 0 0 var(--space-8);
  }
  .not-found__actions { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
  .not-found__link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    background-color: var(--colour-cyan);
    color: var(--colour-bg-primary);
    border-radius: var(--radius-md);
    text-decoration: none;
  }
  .not-found__link--ghost {
    background: transparent;
    color: var(--colour-link);
    padding-left: 0;
    padding-right: 0;
  }
  .not-found__link--ghost:hover { text-decoration: underline; }
</style>